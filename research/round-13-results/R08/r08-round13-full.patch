+def _alternatives(text: str, rng: random.Random) -> str:
+    """[a|b|c] -> один вариант; вложенность не поддерживается (разворачиваем изнутри наружу)."""
+    while True:
+        m = _ALT.search(text)
+        if not m:
+            return text
+        text = text[:m.start()] + rng.choice(m.group(1).split("|")) + text[m.end():]
+
