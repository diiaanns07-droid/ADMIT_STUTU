+{"id": "rd-sgn-ru1-00", "text": "Перекрыли проезд у школы №85 без знаков объезда. Спасибо.", "label": "roads", "language": "ru", "template_id": "rd-sgn-ru1", "family": "signs", "ambiguous": false, "short": false}
