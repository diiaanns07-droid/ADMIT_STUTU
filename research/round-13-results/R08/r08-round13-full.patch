+{"id": "fx-landscaping-ru1-00", "text": "Клумба у поликлиники: в плохом состоянии.", "label": "landscaping", "language": "ru", "template_id": "fx-landscaping-ru1", "family": "lexicon_frame", "ambiguous": false, "short": false}
