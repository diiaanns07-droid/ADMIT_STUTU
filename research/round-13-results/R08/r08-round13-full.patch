+{"id": "rd-sgn-ru1-08", "text": "Прошу обратить внимание: Перекрыли дорогу возле ЖК без знаков объезда.", "label": "roads", "language": "ru", "template_id": "rd-sgn-ru1", "family": "signs", "ambiguous": false, "short": false}
