+{"id": "rd-sgn-ru1-12", "text": "Прошу обратить внимание: Закрыли проезд у дома 41 без знаков объезда.", "label": "roads", "language": "ru", "template_id": "rd-sgn-ru1", "family": "signs", "ambiguous": false, "short": false}
