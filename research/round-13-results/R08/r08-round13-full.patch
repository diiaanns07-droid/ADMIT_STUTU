+{"id": "fx-landscaping-ru3-12", "text": "Возле дома 9: дерево — в ужасном виде.", "label": "landscaping", "language": "ru", "template_id": "fx-landscaping-ru3", "family": "lexicon_frame", "ambiguous": false, "short": false}
