+{"id": "fx-landscaping-ru3-00", "text": "у дома 31: клумба — проблема. спасибо.", "label": "landscaping", "language": "ru", "template_id": "fx-landscaping-ru3", "family": "lexicon_frame", "ambiguous": false, "short": false}
