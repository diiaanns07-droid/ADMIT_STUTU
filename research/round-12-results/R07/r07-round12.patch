@@ -0,0 +1,200 @@
+"""Аудит рисков городского пешеходного графа по сохранённому снимку OSM (без сети).
+
+    python3 -m engine.civic_scenarios.adapters.osm_audit [--out audit.json]
+
+Проверяет то, что нельзя увидеть по числу рёбер:
+  * мосты/тоннели/слои: соединение только через общий ID узла OSM; геометрические пересечения рёбер
+    разных уровней без общего узла считаются (они НЕ должны соединяться) и показываются;
+  * граница выгрузки: граничные узлы лежат у края bbox, а не внутри города;
+  * условный доступ (*:conditional) и барьеры: ни одно такое ребро не стало allowed без явного разрешения;
+  * одноимённые улицы: группы поиска не растягиваются на весь город;
+  * связность allowed-сети: сколько длины в крупнейшей компоненте (остальное — изолированные фрагменты).
+Результат — факты о модели, а не о местности.
+"""
+import argparse
+import gzip
+import hashlib
+import json
+import math
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+from .osm_city import BBOX, distance, foot_access
+
+ROOT = Path(__file__).resolve().parents[3]
+OSM_DIR = ROOT / "data/civic/astana/osm-walking"
+
+
+def _raw():
+    source = json.loads((OSM_DIR / "SOURCE.json").read_text("utf-8"))
+    data = gzip.decompress((OSM_DIR / "overpass.json.gz").read_bytes())
+    if hashlib.sha256(data).hexdigest() != source["raw_sha256"]:
+        raise ValueError("snapshot sha256 differs from SOURCE.json")
+    return json.loads(data), source
+
+
+def _level(t):
+    if t.get("bridge") not in (None, "no"):
+        return "bridge"
+    if t.get("tunnel") not in (None, "no") or t.get("covered") == "yes":
+        return "tunnel"
+    if t.get("layer") not in (None, "0"):
+        return "layer"
+    return "ground"
+
+
+def _segments_cross(p1, p2, q1, q2):
+    def orient(a, b, c):
+        v = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+        return (v > 0) - (v < 0)
+    o1, o2, o3, o4 = orient(p1, p2, q1), orient(p1, p2, q2), orient(q1, q2, p1), orient(q1, q2, p2)
+    return o1 * o2 < 0 and o3 * o4 < 0
+
+
+def audit(graph):
+    raw, source = _raw()
+    ways = {x["id"]: x for x in raw["elements"] if x["type"] == "way"}
+    nodes_raw = {x["id"]: x for x in raw["elements"] if x["type"] == "node"}
+    edges = graph["edges"]
+    nodes = {n["id"]: n for n in graph["nodes"]}
+    report = {"schema": "r07-osm-audit-v1", "graph_id": graph["id"], "graph_digest": graph["digest"],
+              "snapshot_at": source["snapshot_at"], "raw_sha256": source["raw_sha256"]}
+
+    # --- levels: bridges / tunnels -------------------------------------------------
+    level_of = {e["id"]: _level(ways[e["osm_way_id"]].get("tags", {})) for e in edges}
+    by_level = defaultdict(Counter)
+    for e in edges:
+        by_level[level_of[e["id"]]][e["access"]] += 1
+    # geometric crossings between a non-ground edge and any other edge WITHOUT a shared node
+    cell = 0.002
+    grid = defaultdict(list)
+    for i, e in enumerate(edges):
+        for a, b in zip(e["geometry"], e["geometry"][1:]):
+            for cx in range(int(min(a[0], b[0]) // cell), int(max(a[0], b[0]) // cell) + 1):
+                for cy in range(int(min(a[1], b[1]) // cell), int(max(a[1], b[1]) // cell) + 1):
+                    grid[(cx, cy)].append((i, a, b))
+    crossings = Counter()
+    examples = []
+    seen = set()
+    for bucket in grid.values():
+        for x in range(len(bucket)):
+            i, a, b = bucket[x]
+            for y in range(x + 1, len(bucket)):
+                j, c, d = bucket[y]
+                if i == j:
+                    continue
+                ei, ej = edges[i], edges[j]
+                li, lj = level_of[ei["id"]], level_of[ej["id"]]
+                if li == lj == "ground":
+                    continue
+                key = (min(i, j), max(i, j))
+                if key in seen:
+                    continue
+                if {ei["from"], ei["to"]} & {ej["from"], ej["to"]}:
+                    continue
+                if _segments_cross(a, b, c, d):
+                    seen.add(key)
+                    crossings[tuple(sorted((li, lj)))] += 1
+                    if len(examples) < 5:
+                        examples.append({"edge_a": ei["id"], "level_a": li, "edge_b": ej["id"], "level_b": lj,
+                                         "name_a": ei.get("name"), "name_b": ej.get("name")})
+    report["levels"] = {
+        "edges_by_level_and_access": {k: dict(v) for k, v in sorted(by_level.items())},
+        "unconnected_crossings_involving_bridge_tunnel_layer": {"/".join(k): v for k, v in sorted(crossings.items())},
+        "examples": examples,
+        "rule": "рёбра соединяются только через общий ID узла OSM; пересечение линий разных уровней без общего узла не создаёт перехода",
+    }
+
+    # --- boundary ----------------------------------------------------------------
+    w, s, e_, n = graph.get("bbox", BBOX)
+    bdist = []
+    for nd in graph["nodes"]:
+        if nd.get("boundary"):
+            p = [nd["lon"], nd["lat"]]
+            edge_pts = [[w, p[1]], [e_, p[1]], [p[0], s], [p[0], n]]
+            bdist.append(min(distance(p, q) for q in edge_pts))
+    report["boundary"] = {"boundary_nodes": len(bdist),
+                          "max_distance_to_bbox_edge_m": round(max(bdist), 1) if bdist else None,
+                          "median_distance_to_bbox_edge_m": round(sorted(bdist)[len(bdist) // 2], 1) if bdist else None}
+
+    # --- conditional access and barriers ------------------------------------------
+    cond_edges = Counter()
+    for ed in edges:
+        t = ways[ed["osm_way_id"]].get("tags", {})
+        if any(k.endswith(":conditional") for k in t):
+            cond_edges[ed["access"]] += 1
+    barrier_nodes = {nid for nid, x in nodes_raw.items() if x.get("tags", {}).get("barrier") not in (None, "no")}
+    barrier_edges = Counter()
+    barrier_allowed_explicit = 0
+    for ed in edges:
+        ends = [int(ed[k][5:]) for k in ("from", "to")]
+        bn = [x for x in ends if x in barrier_nodes]
+        if bn:
+            barrier_edges[ed["access"]] += 1
+            if ed["access"] == "allowed":
+                if all(foot_access(nodes_raw[x]["tags"], node=True) == "allowed" for x in bn):
+                    barrier_allowed_explicit += 1
+    report["conditional_access"] = {"edges_by_access": dict(cond_edges),
+                                    "rule": "*:conditional не превращается в постоянный allowed"}
+    report["barriers"] = {"edges_touching_barrier_by_access": dict(barrier_edges),
+                          "allowed_only_with_explicit_node_permission": barrier_allowed_explicit,
+                          "rule": "барьер без явного foot/access=yes делает ребро unknown"}
+
+    # --- street namesakes (search index) -------------------------------------------
+    streets = json.loads((ROOT / "web/civic/map/streets.json").read_text("utf-8"))["streets"]
+    per_name = Counter(s_["name"] for s_ in streets)
+    spans = []
+    for st in streets:
+        b = st["bbox"]
+        spans.append((round(distance([b[0], b[1]], [b[2], b[3]])), st["label"]))
+    spans.sort(reverse=True)
+    report["street_search"] = {"names": len(per_name), "entries": len(streets),
+                               "names_with_several_parts": sum(1 for v in per_name.values() if v > 1),
+                               "largest_bbox_diagonals_m": [{"m": m, "label": lab} for m, lab in spans[:5]]}
+
+    # --- connectivity of the allowed network --------------------------------------
+    parent = {}
+
+    def find(a):
+        parent.setdefault(a, a)
+        while parent[a] != a:
+            parent[a] = parent[parent[a]]
+            a = parent[a]
+        return a
+    for ed in edges:
+        if ed["access"] == "allowed":
+            parent[find(ed["from"])] = find(ed["to"])
+    comp_len = Counter()
+    for ed in edges:
+        if ed["access"] == "allowed":
+            comp_len[find(ed["from"])] += ed["length_m"]
+    total = sum(comp_len.values())
+    top = comp_len.most_common(3)
+    report["allowed_connectivity"] = {
+        "components": len(comp_len), "allowed_length_km": round(total / 1000, 1),
+        "largest_component_share_of_length": round(top[0][1] / total, 4) if total else None,
+        "top3_component_km": [round(v / 1000, 1) for _, v in top],
+        "note": "маленькие компоненты — фрагменты, соединённые с остальной сетью только рёбрами с неизвестным доступом "
+                "или вне среза; путь между ними в строгом расчёте не найдётся",
+    }
+    return report
+
+
+def main(argv=None):
+    from ..registry import load_graph_dict
+    from .osm_city import GRAPH_ID
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--out", type=Path)
+    a = ap.parse_args(argv)
+    rep = audit(load_graph_dict(GRAPH_ID))
+    text = json.dumps(rep, ensure_ascii=False, indent=1)
+    if a.out:
+        a.out.write_text(text + "\n", encoding="utf-8")
+    else:
+        sys.stdout.write(text + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
