+"""R07 round 12: closures reuse the prepared city network instead of rebuilding it.
+
+The overlay adjacency must give exactly the same routes as a full rebuild (reference
+implementation below), and repeated scenario edits must not rebuild the base index.
+"""
+import json
+import random
+from pathlib import Path
+
+import pytest
+
+from engine.civic_scenarios import compare
+from engine.civic_scenarios.adapters.osm_city import GRAPH_ID
+from engine.civic_scenarios.compare import EXPLORATORY, STRICT
+from engine.civic_scenarios.registry import load_graph
+from engine.civic_scenarios.routing import dijkstra, reachable
+
+ROOT = Path(__file__).resolve().parents[3]
+CITY_CASE = json.loads((ROOT / "engine/civic_scenarios/cases/astana-citywide-v1.case.json").read_text("utf-8"))
+
+
+def naive_adjacency(pg, accesses, closed, reverse=False):
+    """Pre-round-12 behaviour: rebuild the whole index for every closure set."""
+    adj = {}
+    for eid in sorted(pg.edges):
+        frm, to, mm, access, oneway = pg.edges[eid]
+        if access not in accesses or eid in closed:
+            continue
+        for a, b in ([(frm, to)] if oneway else [(frm, to), (to, frm)]):
+            if reverse:
+                a, b = b, a
+            adj.setdefault(a, []).append((eid, b, mm))
+    return adj
+
+
+@pytest.fixture(scope="module")
+def city():
+    return load_graph(GRAPH_ID)
+
+
+def test_overlay_equals_full_rebuild_on_city_graph(city):
+    rnd = random.Random(12)
+    allowed = sorted(e for e, rec in city.edges.items() if rec[3] == "allowed")
+    unknown = sorted(e for e, rec in city.edges.items() if rec[3] == "unknown")
+    origin = CITY_CASE["payload"]["origin_node_ids"][0]
+    for _ in range(4):
+        closed = frozenset(rnd.sample(allowed, 40) + rnd.sample(unknown, 10))
+        for accesses, reverse in ((STRICT, False), (EXPLORATORY, False), (EXPLORATORY, True)):
+            fast = city.adjacency(accesses, closed, reverse)
+            ref = naive_adjacency(city, accesses, closed, reverse)
+            touched = {n for e in closed for n in city.edges[e][:2]}
+            for u in touched | set(rnd.sample(sorted(ref), 200)):
+                assert list(fast.get(u, ())) == ref.get(u, []), u
+        d_fast = dijkstra(city.adjacency(STRICT, closed), origin)[0]
+        d_ref = dijkstra(naive_adjacency(city, STRICT, closed), origin)[0]
+        assert d_fast == d_ref
+        assert reachable(city.adjacency(EXPLORATORY, closed), origin) == reachable(
+            naive_adjacency(city, EXPLORATORY, closed), origin)
+
+
+def test_repeated_edits_do_not_rebuild_base_and_cache_is_bounded(city):
+    payload = json.loads(json.dumps(CITY_CASE["payload"]))
+    compare(payload, city)
+    builds = city.stats["base_builds"]
+    assert builds <= 4 and len(city._base_adj) <= 4
+    allowed = sorted(e for e, rec in city.edges.items() if rec[3] == "allowed")
+    for i in range(city.OVERLAY_CACHE + 5):  # many different edits
+        payload["plans"][0]["closures"][0]["edge_ids"] = [allowed[i * 97]]
+        compare(payload, city)
+    assert city.stats["base_builds"] == builds
+    assert len(city._adj_cache) <= city.OVERLAY_CACHE
+
+
+def test_city_example_numbers_are_unchanged(city):
+    r = compare(CITY_CASE["payload"], city)
+    assert r["baseline"]["routes"][0]["length_m"] == 18980.904
+    assert [p["routes"][0]["length_m"] for p in r["plans"]] == [18998.069, 18987.577]
