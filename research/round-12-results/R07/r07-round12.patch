+    def adjacency(self, accesses, closed, reverse=False):
+        """Смежность: node -> [(edge_id, neighbor, mm)], отсортированная по edge_id.
+
+        accesses — допустимые значения access; closed — множество закрытых edge_id (обе стороны).
+        Возвращает dict (без перекрытий) или _Overlay; обе формы читаются только через .get().
+        """
+        accesses = tuple(sorted(accesses))
+        closed = frozenset(closed)
+        with self._lock:
+            base = self._base(accesses, reverse)
+            if not closed:
+                return base
+            key = (accesses, closed, reverse)
+            ov = self._adj_cache.get(key)
+            if ov is not None:
+                self._adj_cache.move_to_end(key)
+                self.stats["overlay_hits"] += 1
+                return ov
+            touched = set()
+            for eid in closed:
+                rec = self.edges.get(eid)
+                if rec is not None and rec[3] in accesses:
+                    touched.update((rec[0], rec[1]))
+            over = {u: [t for t in base.get(u, ()) if t[0] not in closed] for u in touched}
+            ov = _Overlay(base, over)
+            self._adj_cache[key] = ov
+            while len(self._adj_cache) > self.OVERLAY_CACHE:
+                self._adj_cache.popitem(last=False)
+            self.stats["overlay_builds"] += 1
+            return ov
