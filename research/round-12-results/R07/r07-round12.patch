+class _Overlay:
+    """Read-only view: base adjacency with a few node lists replaced (closed edges removed).
+
+    Only ``get`` is provided — the routing code reads adjacency exclusively through it.
+    """
+    __slots__ = ("base", "over")
+
+    def __init__(self, base, over):
+        self.base = base
+        self.over = over
+
+    def get(self, node, default=None):
+        row = self.over.get(node)
+        if row is not None:
+            return row
+        return self.base.get(node, default)
