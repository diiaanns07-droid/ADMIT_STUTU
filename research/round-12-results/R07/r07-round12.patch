+"""R07 round 12: invariants of the real city graph against the saved OSM snapshot.
+
+Bridges/tunnels, crop boundary, barriers and conditional access are checked on the actual
+data, not only on tiny fixtures. Facts about the model, not about the street.
+"""
+import gzip
+import json
+from pathlib import Path
+
+import pytest
+
+from engine.civic_scenarios.adapters.osm_audit import audit
+from engine.civic_scenarios.adapters.osm_city import BBOX, GRAPH_ID, foot_access
+from engine.civic_scenarios.registry import load_graph_dict
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+@pytest.fixture(scope="module")
+def data():
+    raw = json.loads(gzip.decompress((ROOT / "data/civic/astana/osm-walking/overpass.json.gz").read_bytes()))
+    nodes = {x["id"]: x for x in raw["elements"] if x["type"] == "node"}
+    ways = {x["id"]: x for x in raw["elements"] if x["type"] == "way"}
+    return load_graph_dict(GRAPH_ID), nodes, ways
+
+
+def inside(n):
+    return BBOX[0] <= n["lon"] <= BBOX[2] and BBOX[1] <= n["lat"] <= BBOX[3]
+
+
+def test_every_graph_node_is_a_real_osm_node(data):
+    """No invented intersection nodes: bridges/tunnels can only connect through shared OSM node IDs."""
+    graph, nodes, _ = data
+    for n in graph["nodes"]:
+        raw = nodes[int(n["id"][len("osm-n"):])]
+        assert (raw["lon"], raw["lat"]) == (n["lon"], n["lat"])
+
+
+def test_edges_follow_their_osm_way(data):
+    graph, nodes, ways = data
+    for e in graph["edges"][::50]:                      # sample: 1 of 50 edges
+        way = ways[e["osm_way_id"]]["nodes"]
+        coords = [[nodes[i]["lon"], nodes[i]["lat"]] for i in way]
+        first = coords.index(e["geometry"][0]) if e["geometry"][0] in coords else None
+        assert first is not None, e["id"]
+        seg = e["geometry"]
+        fwd = coords[first:first + len(seg)]
+        back = coords[max(0, first - len(seg) + 1):first + 1][::-1]
+        assert seg in (fwd, back), e["id"]
+
+
+def test_boundary_nodes_really_touch_outside(data):
+    graph, nodes, ways = data
+    boundary = {int(n["id"][5:]) for n in graph["nodes"] if n.get("boundary")}
+    neighbours = {b: [] for b in boundary}
+    for w in ways.values():
+        ids = w["nodes"]
+        for i, nid in enumerate(ids):
+            if nid in neighbours:
+                neighbours[nid] += [ids[j] for j in (i - 1, i + 1) if 0 <= j < len(ids)]
+    for b, nb in neighbours.items():
+        assert inside(nodes[b]) and any(not inside(nodes[x]) for x in nb), b
+
+
+def test_barriers_and_conditional_never_become_allowed(data):
+    graph, nodes, ways = data
+    for e in graph["edges"]:
+        if e["access"] != "allowed":
+            continue
+        tags = ways[e["osm_way_id"]].get("tags", {})
+        assert not any(k.endswith(":conditional") for k in tags), e["id"]
+        for end in (e["from"], e["to"]):
+            t = nodes[int(end[5:])].get("tags", {})
+            if t.get("barrier") not in (None, "no"):
+                assert foot_access(t, node=True) == "allowed", e["id"]
+
+
+def test_audit_report_shape(data):
+    rep = audit(data[0])
+    assert rep["levels"]["unconnected_crossings_involving_bridge_tunnel_layer"]
+    assert rep["barriers"]["edges_touching_barrier_by_access"].get("allowed", 0) == rep["barriers"]["allowed_only_with_explicit_node_permission"]
+    assert 0 < rep["allowed_connectivity"]["largest_component_share_of_length"] < 1
