@@ -0,0 +1,155 @@
+"""Расписание двух вариантов работ: A и B на каждом отрезке между границами интервалов.
+
+    schedule(payload, graph) -> civic-scenario-schedule-v1
+
+Окно — от самого раннего start_at до самого позднего end_at перекрытий обоих планов (с участками).
+Окно режется по всем границам интервалов A и B; внутри отрезка набор действующих перекрытий
+постоянен (правило start_at <= t < end_at), поэтому каждое уникальное состояние считается один раз
+обычным compare() с analysis_at = начало отрезка. Та же сегментация реализована в UI
+(web/civic/scenarios/scenarios.js, scheduleSegments) — тест сверяет их.
+
+Итог по окну берётся из timeline(): м·ч добавочной длины и пара·ч без пути в модели. Это длина пути
+по графу, умноженная на часы, а не время в пути, не задержка и не число пострадавших жителей.
+
+CLI (воспроизводимый расчёт по сохранённому кейсу):
+    python3 -m engine.civic_scenarios.schedule engine/civic_scenarios/cases/<case>.case.json [--out file.json]
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+from .canon import sha256_hex
+from .compare import EXPLORATORY, compare
+from .graph import PreparedGraph, prepare_graph
+from .payload import parse_ts, utc_iso, validate_payload
+from .routing import dijkstra
+from .timeline import timeline
+
+SCHEMA = "civic-scenario-schedule-v1"
+
+
+def segments(plans):
+    """Отрезки расписания по сырым plans payload (строки ISO). Повторяет scheduleSegments из UI."""
+    closures = [c for p in plans for c in p["closures"] if c["edge_ids"]]
+    iso = {}
+    for c in closures:
+        for key in ("start_at", "end_at"):
+            iso.setdefault(parse_ts(c[key], key), c[key])
+    cuts = sorted(iso)
+    out = []
+    for t0, t1 in zip(cuts, cuts[1:]):
+        active = {}
+        for p in plans:
+            ids = set()
+            for c in p["closures"]:
+                if c["edge_ids"] and parse_ts(c["start_at"], "start_at") <= t0 < parse_ts(c["end_at"], "end_at"):
+                    ids.update(c["edge_ids"])
+            active[p["id"]] = sorted(ids)
+        out.append({
+            "start_at": iso[t0], "end_at": iso[t1],
+            "start_utc": utc_iso(t0), "end_utc": utc_iso(t1),
+            "duration_h": round((t1 - t0).total_seconds() / 3600, 6),
+            "active": active,
+            "key": "|".join(p["id"] + ":" + ",".join(active[p["id"]]) for p in plans),
+            "none_active": all(not active[p["id"]] for p in plans),
+        })
+    return out
+
+
+def _pair_rows(res, plan_id):
+    plan = next(p for p in res["plans"] if p["id"] == plan_id)
+    deltas = {(d["origin_node_id"], d["destination_node_id"]): d for d in plan["vs_baseline"]["pairs"]}
+    rows = []
+    for r in plan["routes"]:
+        d = deltas[(r["origin_node_id"], r["destination_node_id"])]
+        rows.append({"origin_node_id": r["origin_node_id"], "destination_node_id": r["destination_node_id"],
+                     "status": r["status"], "reason": r["reason"], "length_m": r["length_m"],
+                     "delta_m": d["delta_m"], "change": d["change"]})
+    return {"active_closed_edge_ids": plan["active_closed_edge_ids"], "pairs": rows,
+            "summary": plan["vs_baseline"]["summary"]}
+
+
+def _sensitivity(pg, origins, dests, closed):
+    """Длины, если бы рёбра с неизвестным доступом были разрешены (только для оценки зависимости
+    результата от неизвестного доступа; в решениях и в основном расчёте не используется)."""
+    adj = pg.adjacency(EXPLORATORY, frozenset(closed))
+    out = {}
+    for o in origins:
+        dist = dijkstra(adj, o)[0]
+        for d in dests:
+            out[(o, d)] = dist[d] / 1000 if d in dist else None
+    return out
+
+
+def schedule(payload, graph):
+    pg = graph if isinstance(graph, PreparedGraph) else prepare_graph(graph)
+    validate_payload(payload, pg)
+    plans = sorted(payload["plans"], key=lambda p: p["id"])
+    segs = segments(plans)
+    if not segs:
+        raise ValueError("в планах нет перекрытий с участками — расписание пустое")
+    cache = {}
+    out_segments = []
+    for sg in segs:
+        if sg["key"] not in cache:
+            body = dict(payload, analysis_at=sg["start_at"])
+            cache[sg["key"]] = compare(body, pg)
+        res = cache[sg["key"]]
+        out_segments.append(dict(sg, result_digest=res["result_digest"],
+                                 plans={p["id"]: _pair_rows(res, p["id"]) for p in plans}))
+    origins, dests = payload["origin_node_ids"], payload["destination_node_ids"]
+    sens_base = _sensitivity(pg, origins, dests, ())
+    for sg in out_segments:
+        for pid, pl in sg["plans"].items():
+            sens = _sensitivity(pg, origins, dests, pl["active_closed_edge_ids"])
+            for row in pl["pairs"]:
+                k = (row["origin_node_id"], row["destination_node_id"])
+                b, v = sens_base[k], sens[k]
+                row["if_unknown_access_allowed"] = {
+                    "baseline_length_m": b, "length_m": v,
+                    "delta_m": None if b is None or v is None else round(v - b, 3)}
+    any_res = next(iter(cache.values()))
+    baseline = [{"origin_node_id": r["origin_node_id"], "destination_node_id": r["destination_node_id"],
+                 "status": r["status"], "length_m": r["length_m"]} for r in any_res["baseline"]["routes"]]
+    window = (segs[0]["start_at"], segs[-1]["end_at"])
+    tl = timeline(payload, pg, *window)
+    result = {
+        "schema_version": SCHEMA,
+        "input": {"payload_digest": sha256_hex(payload), "graph_id": pg.id, "graph_digest": pg.digest,
+                  "mode": pg.mode, "graph_evidence_type": pg.evidence_type,
+                  "window_start": window[0], "window_end": window[1], "interval_rule": "start_at <= t < end_at"},
+        "baseline": baseline,
+        "segments": out_segments,
+        "unique_states_computed": len(cache),
+        "totals": {p["id"]: p["totals"] for p in tl["plans"]},
+        "timeline_result_digest": tl["result_digest"],
+        "sensitivity_note": "if_unknown_access_allowed — справочный пересчёт, где рёбра с неизвестным доступом "
+                            "считаются разрешёнными. Если там delta_m близка к 0, обход в основном расчёте "
+                            "вызван политикой неизвестного доступа, а не доказанным отсутствием пути на месте.",
+        "note": "Длина пути по графу (м); м·ч и пара·ч — разные величины, общий балл не вычисляется. "
+                "Не время в пути, не пробки, не число жителей. Перекрытия — гипотеза, не официальное решение.",
+    }
+    result["result_digest"] = sha256_hex({k: v for k, v in result.items() if k != "result_digest"})
+    return result
+
+
+def main(argv=None):
+    from .registry import load_graph
+    ap = argparse.ArgumentParser(description="Расписание вариантов A/B по сохранённому кейсу")
+    ap.add_argument("case", type=Path)
+    ap.add_argument("--out", type=Path)
+    a = ap.parse_args(argv)
+    case = json.loads(a.case.read_text("utf-8"))
+    payload = case.get("payload", case)
+    res = schedule(payload, load_graph(payload["graph_id"]))
+    text = json.dumps(res, ensure_ascii=False, indent=1)
+    if a.out:
+        a.out.write_text(text + "\n", encoding="utf-8")
+    else:
+        sys.stdout.write(text + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
