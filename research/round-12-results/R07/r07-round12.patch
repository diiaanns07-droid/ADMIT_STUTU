+++ b/engine/civic_scenarios/mapping.py
@@ -0,0 +1,385 @@
+"""Предлагаемое сопоставление объекта работ (геометрия civic-v1) с участками графа.
+
+    propose_mapping(geometry, geometry_precision, graph_dict, osm_tags=None) -> civic-scenario-mapping-v1
+
+Это ПРЕДЛОЖЕНИЕ для человека, а не перекрытие. Функция ничего не закрывает и никогда не выбирает
+«ближайшую линию» автоматически: каждый кандидат объясняется (доля участка рядом с объектом,
+расстояние, доступ, тип OSM, мост/тоннель), а итог всегда requires_confirmation=true.
+
+Правила (метры, локальная равнопромежуточная проекция вокруг объекта; погрешность в пределах города < 0,5 %):
+  буфер по точности геометрии: source 12 м, approximate 35 м, unknown 60 м (+ предупреждение);
+  LineString: участок «proposed», если >= 60 % его длины в буфере линии объекта; 20–60 % — «partial»
+              (проверить; так выглядят пересекающие улицы и соседние дорожки); меньше — не показывается;
+              части линии объекта дальше буфера от предложенных участков — unmatched_object_parts;
+  Polygon:    «proposed» — >= 60 % длины участка внутри полигона (дыры учитываются), «partial» — 20–60 %
+              или участок у границы в пределах буфера;
+  Point:      точка не задаёт протяжённость: до 10 ближайших участков в радиусе 2×буфер только как
+              «partial», статус point_needs_manual_selection;
+  null:       no_geometry (объект показывается списком, сопоставление невозможно).
+Предупреждения: кандидаты образуют несвязанные группы (параллельные тротуары, мост над дорогой, разрыв);
+кандидат на мосту/в тоннеле (по тегам OSM исходного снимка); доступ кандидата не «allowed».
+"""
+import gzip
+import hashlib
+import json
+import math
+from pathlib import Path
+
+from .canon import sha256_hex
+from .errors import ScenarioError
+
+SCHEMA = "civic-scenario-mapping-v1"
+BUFFER_M = {"source": 12.0, "approximate": 35.0, "unknown": 60.0}
+PROPOSE_SHARE = 0.6
+PARTIAL_SHARE = 0.2
+STEP_M = 5.0
+CELL_M = 100.0
+MAX_VERTICES = 2000
+MAX_POINT_CANDIDATES = 10
+ROOT = Path(__file__).resolve().parents[2]
+OSM_DIR = ROOT / "data/civic/astana/osm-walking"
+
+
+def _bad(msg, **fields):
+    raise ScenarioError("invalid_payload", msg, fields or None)
+
+
+class _Proj:
+    def __init__(self, lon0, lat0):
+        self.lon0, self.lat0 = lon0, lat0
+        self.kx = 111320.0 * math.cos(math.radians(lat0))
+        self.ky = 110540.0
+
+    def __call__(self, p):
+        return ((p[0] - self.lon0) * self.kx, (p[1] - self.lat0) * self.ky)
+
+
+def _densify(pts, step=STEP_M):
+    out = [pts[0]]
+    for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
+        L = math.hypot(x1 - x0, y1 - y0)
+        n = max(1, int(math.ceil(L / step)))
+        for i in range(1, n + 1):
+            t = i / n
+            out.append((x0 + (x1 - x0) * t, y0 + (y1 - y0) * t))
+    return out
+
+
+def _seg_dist(p, a, b):
+    ax, ay = a
+    dx, dy = b[0] - ax, b[1] - ay
+    L2 = dx * dx + dy * dy
+    t = 0.0 if L2 == 0 else max(0.0, min(1.0, ((p[0] - ax) * dx + (p[1] - ay) * dy) / L2))
+    return math.hypot(p[0] - (ax + t * dx), p[1] - (ay + t * dy))
+
+
+def _line_dist(p, line):
+    return min(_seg_dist(p, a, b) for a, b in zip(line, line[1:])) if len(line) > 1 else math.hypot(p[0] - line[0][0], p[1] - line[0][1])
+
+
+def _in_ring(p, ring):
+    x, y = p
+    inside = False
+    for (x0, y0), (x1, y1) in zip(ring, ring[1:] + ring[:1]):
+        if (y0 > y) != (y1 > y) and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0):
+            inside = not inside
+    return inside
+
+
+def _check_coords(coords, depth, where):
+    def pt(c):
+        if (not isinstance(c, list) or len(c) < 2 or not all(isinstance(v, (int, float)) and not isinstance(v, bool)
+                                                              and math.isfinite(v) for v in c[:2])
+                or abs(c[0]) > 180 or abs(c[1]) > 90):
+            _bad(f"{where}: координаты — [долгота, широта] WGS84", field="geometry")
+        return [float(c[0]), float(c[1])]
+    if depth == 0:
+        return pt(coords)
+    if not isinstance(coords, list) or not coords:
+        _bad(f"{where}: пустые координаты", field="geometry")
+    return [_check_coords(c, depth - 1, where) for c in coords]
+
+
+def validate_geometry(geometry):
+    if geometry is None:
+        return None
+    if not isinstance(geometry, dict) or set(geometry) - {"type", "coordinates"}:
+        _bad("geometry — GeoJSON {type, coordinates} или null", field="geometry")
+    kind = geometry.get("type")
+    depth = {"Point": 0, "LineString": 1, "Polygon": 2}.get(kind)
+    if depth is None:
+        _bad("geometry.type — Point | LineString | Polygon", field="geometry")
+    coords = _check_coords(geometry.get("coordinates"), depth, kind)
+    n = 1 if depth == 0 else len(coords) if depth == 1 else sum(len(r) for r in coords)
+    if n > MAX_VERTICES:
+        raise ScenarioError("too_large", f"geometry: не больше {MAX_VERTICES} вершин")
+    if kind == "LineString" and len(coords) < 2:
+        _bad("LineString: минимум 2 точки", field="geometry")
+    if kind == "Polygon" and any(len(r) < 4 for r in coords):
+        _bad("Polygon: кольцо минимум из 4 точек (замкнутое)", field="geometry")
+    return {"type": kind, "coordinates": coords}
+
+
+class EdgeGrid:
+    """Сетка 100 м по bbox геометрии рёбер; строится один раз на граф (кэш по digest)."""
+
+    def __init__(self, graph):
+        self.digest = graph["digest"]
+        nodes = {n["id"]: (n["lon"], n["lat"]) for n in graph["nodes"]}
+        self.edges = {}
+        lats = [n["lat"] for n in graph["nodes"]] or [0.0]
+        self.proj = _Proj(0.0, sum(lats) / len(lats))   # общая проекция только для индекса
+        self.cells = {}
+        for e in graph["edges"]:
+            geom = e.get("geometry") or [list(nodes[e["from"]]), list(nodes[e["to"]])]
+            self.edges[e["id"]] = (e, geom)
+            xy = [self.proj(p) for p in geom]
+            x0, y0 = min(p[0] for p in xy), min(p[1] for p in xy)
+            x1, y1 = max(p[0] for p in xy), max(p[1] for p in xy)
+            for cx in range(int(x0 // CELL_M), int(x1 // CELL_M) + 1):
+                for cy in range(int(y0 // CELL_M), int(y1 // CELL_M) + 1):
+                    self.cells.setdefault((cx, cy), []).append(e["id"])
+
+    def near(self, lonlat_points, radius_m):
+        xy = [self.proj(p) for p in lonlat_points]
+        x0, y0 = min(p[0] for p in xy) - radius_m, min(p[1] for p in xy) - radius_m
+        x1, y1 = max(p[0] for p in xy) + radius_m, max(p[1] for p in xy) + radius_m
+        out = set()
+        for cx in range(int(x0 // CELL_M), int(x1 // CELL_M) + 1):
+            for cy in range(int(y0 // CELL_M), int(y1 // CELL_M) + 1):
+                out.update(self.cells.get((cx, cy), ()))
+        return sorted(out)
+
+
+_GRIDS = {}
+_TAGS = {}
+
+
+def grid_for(graph):
+    g = _GRIDS.get(graph["digest"])
+    if g is None:
+        _GRIDS.clear()      # один городской граф в памяти
+        g = _GRIDS[graph["digest"]] = EdgeGrid(graph)
+    return g
+
+
+def osm_way_tags():
+    """Теги путей исходного снимка (мост/тоннель/слой/тип). sha256 сверяется с SOURCE.json."""
+    if "ways" in _TAGS:
+        return _TAGS["ways"]
+    source = json.loads((OSM_DIR / "SOURCE.json").read_text("utf-8"))
+    raw = gzip.decompress((OSM_DIR / "overpass.json.gz").read_bytes())
+    if hashlib.sha256(raw).hexdigest() != source["raw_sha256"]:
+        raise ScenarioError("graph_digest_mismatch", "исходный снимок OSM не совпадает с SOURCE.json")
+    keep = ("highway", "bridge", "tunnel", "layer", "covered", "footway", "sidewalk")
+    ways = {}
+    for x in json.loads(raw)["elements"]:
+        if x["type"] == "way":
+            t = x.get("tags", {})
+            ways[x["id"]] = {k: t[k] for k in keep if k in t}
+    _TAGS["ways"] = ways
+    return ways
+
+
+def _components(cands, edges):
+    parent = {c: c for c in cands}
+
+    def find(a):
+        while parent[a] != a:
+            parent[a] = parent[parent[a]]
+            a = parent[a]
+        return a
+    by_node = {}
+    for c in cands:
+        e = edges[c][0]
+        for n in (e["from"], e["to"]):
+            if n in by_node:
+                parent[find(c)] = find(by_node[n])
+            else:
+                by_node[n] = c
+    roots = sorted({find(c) for c in cands})
+    return {c: roots.index(find(c)) + 1 for c in cands}
+
+
+def propose_mapping(geometry, geometry_precision, graph, osm_tags=None):
+    geom = validate_geometry(geometry)
+    precision = geometry_precision if geometry_precision in BUFFER_M else "unknown"
+    buf = BUFFER_M[precision]
+    base = {"schema_version": SCHEMA, "graph_id": graph["id"], "graph_digest": graph["digest"],
+            "input_digest": sha256_hex({"geometry": geometry, "geometry_precision": geometry_precision}),
+            "requires_confirmation": True,
+            "rule": {"buffer_m": buf, "precision": precision, "propose_share": PROPOSE_SHARE,
+                     "partial_share": PARTIAL_SHARE, "sample_step_m": STEP_M},
+            "proposed": [], "partial": [], "unmatched_object_parts": [], "warnings": [],
+            "note": "Предложение для проверки человеком. Ни один участок не закрывается автоматически; "
+                    "совпадение линий на карте не доказывает, что объект работ — эта дорога или дорожка."}
+    if geom is None:
+        return _finish(dict(base, status="no_geometry",
+                            warnings=[{"code": "no_geometry", "message": "у объекта нет достоверной геометрии; сопоставление невозможно"}]), None)
+    if precision != geometry_precision or precision == "unknown":
+        base["warnings"].append({"code": "precision_unknown",
+                                 "message": "точность геометрии неизвестна: сопоставление только ориентировочное"})
+    grid = grid_for(graph)
+    kind = geom["type"]
+    if kind == "Point":
+        pts = [geom["coordinates"]]
+    elif kind == "LineString":
+        pts = geom["coordinates"]
+    else:
+        pts = [p for ring in geom["coordinates"] for p in ring]
+    lon0 = sum(p[0] for p in pts) / len(pts)
+    lat0 = sum(p[1] for p in pts) / len(pts)
+    proj = _Proj(lon0, lat0)
+    radius = buf * 2 if kind == "Point" else buf
+    cand_ids = grid.near(pts, radius)
+    tags = osm_tags if osm_tags is not None else {}
+
+    def describe(eid, share, dists):
+        e, _ = grid.edges[eid]
+        t = tags.get(e.get("osm_way_id"), {})
+        row = {"edge_id": eid, "name": e.get("name") or None, "access": e["access"], "length_m": e["length_m"],
+               "share_near_object": round(share, 3), "mean_distance_m": round(sum(dists) / len(dists), 1),
+               "max_distance_m": round(max(dists), 1), "osm_way_id": e.get("osm_way_id"),
+               "osm_highway": t.get("highway")}
+        level = {k: t[k] for k in ("bridge", "tunnel", "layer", "covered") if k in t and t[k] != "no"}
+        if level:
+            row["osm_level"] = level
+        return row
+
+    if kind == "Point":
+        p = proj(geom["coordinates"])
+        rows = []
+        for eid in cand_ids:
+            line = [proj(q) for q in grid.edges[eid][1]]
+            d = _line_dist(p, line)
+            if d <= radius:
+                rows.append((d, eid))
+        rows.sort()
+        partial = [describe(eid, 0.0, [d]) for d, eid in rows[:MAX_POINT_CANDIDATES]]
+        res = dict(base, status="point_needs_manual_selection" if partial else "no_candidates", partial=partial)
+        res["warnings"].append({"code": "point_geometry",
+                                "message": "точка не задаёт протяжённость работ: выберите участки вручную"})
+        return _finish(res, grid)
+
+    if kind == "LineString":
+        obj = [proj(q) for q in geom["coordinates"]]
+        inside = lambda q: _line_dist(q, obj) <= buf                      # noqa: E731
+        dist_to_obj = lambda q: _line_dist(q, obj)                          # noqa: E731
+    else:
+        rings = [[proj(q) for q in ring] for ring in geom["coordinates"]]
+        outer, holes = rings[0], rings[1:]
+        boundary = [r for r in rings]
+
+        def dist_to_obj(q):
+            return min(_line_dist(q, r + r[:1]) for r in boundary)
+
+        def inside(q):
+            return _in_ring(q, outer) and not any(_in_ring(q, h) for h in holes)
+
+    proposed, partial = [], []
+    for eid in cand_ids:
+        line = _densify([proj(q) for q in grid.edges[eid][1]])
+        flags = [inside(q) for q in line]
+        dists = [0.0 if (kind == "Polygon" and f) else dist_to_obj(q) for q, f in zip(line, flags)]
+        share = sum(flags) / len(flags)
+        if kind == "Polygon" and share < PROPOSE_SHARE and min(dists) <= buf:
+            share = max(share, PARTIAL_SHARE)            # участок у границы полигона — проверить
+        if share >= PROPOSE_SHARE:
+            proposed.append(describe(eid, share, dists))
+        elif share >= PARTIAL_SHARE:
+            partial.append(describe(eid, share, dists))
+    proposed.sort(key=lambda r: r["edge_id"])
+    partial.sort(key=lambda r: r["edge_id"])
+
+    if kind == "LineString" and len(obj) > 1:
+        samples = _densify(obj)
+        prop_lines = [[proj(q) for q in grid.edges[r["edge_id"]][1]] for r in proposed]
+        covered = [any(_line_dist(q, l) <= buf for l in prop_lines) for q in samples]
+        pos, run = [0.0], None
+        for a, b in zip(samples, samples[1:]):
+            pos.append(pos[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))
+        for i, c in enumerate(covered + [True]):
+            if not c and run is None:
+                run = i
+            elif c and run is not None:
+                part = {"from_m": round(pos[run], 1), "to_m": round(pos[i - 1], 1),
+                        "length_m": round(pos[i - 1] - pos[run], 1)}
+                if part["length_m"] >= STEP_M:
+                    base["unmatched_object_parts"].append(part)
+                run = None
+        base["object_length_m"] = round(pos[-1], 1)
+        base["object_covered_share"] = round(sum(covered) / len(covered), 3)
+    status = "proposed" if proposed else ("partial_only" if partial else "no_candidates")
+    return _finish(dict(base, status=status, proposed=proposed, partial=partial), grid)
+
+
+def _finish(res, grid):
+    w = res["warnings"]
+    if res["proposed"]:
+        groups = _components([r["edge_id"] for r in res["proposed"]], grid.edges)
+        for r in res["proposed"]:
+            r["group"] = groups[r["edge_id"]]
+        n = max(groups.values())
+        # Сводка по исходным линиям OSM: человеку проще решить «тротуар в 5 м» против «проезжая часть в 19 м».
+        ways = {}
+        for r in res["proposed"]:
+            way = ways.setdefault(r["osm_way_id"], {"osm_way_id": r["osm_way_id"], "name": r["name"],
+                                                  "osm_highway": r["osm_highway"], "access": set(), "edges": 0,
+                                                  "length_m": 0.0, "_wd": 0.0})
+            way["access"].add(r["access"]); way["edges"] += 1
+            way["length_m"] += r["length_m"]; way["_wd"] += r["mean_distance_m"] * r["length_m"]
+        summary = []
+        for way in ways.values():
+            way["mean_distance_m"] = round(way.pop("_wd") / way["length_m"], 1) if way["length_m"] else None
+            way["length_m"] = round(way["length_m"], 1)
+            way["access"] = sorted(way["access"])
+            summary.append(way)
+        summary.sort(key=lambda x: (x["mean_distance_m"] is None, x["mean_distance_m"], str(x["osm_way_id"])))
+        res["by_osm_way"] = summary
+        if n > 1:
+            w.append({"code": "disconnected_groups", "count": n,
+                      "message": f"предложенные участки образуют {n} несвязанные группы: это могут быть тротуары "
+                                 "по обе стороны, мост над дорогой или разрыв сети — подтвердите каждую"})
+    for key in ("proposed", "partial"):
+        lv = [r["edge_id"] for r in res[key] if "osm_level" in r]
+        if lv:
+            w.append({"code": "bridge_or_tunnel_" + key, "edge_ids": lv,
+                      "message": "среди кандидатов есть мост/тоннель/другой уровень (OSM): линия объекта может "
+                                 "относиться к другому уровню"})
+    na = [r["edge_id"] for r in res["proposed"] if r["access"] != "allowed"]
+    if na:
+        w.append({"code": "proposed_not_allowed", "edge_ids": na,
+                  "message": "часть предложенных участков и так не используется в строгом расчёте (доступ неизвестен/запрещён)"})
+    if res.get("unmatched_object_parts"):
+        w.append({"code": "unmatched_object_parts",
+                  "message": "часть линии объекта не совпала ни с одним участком графа (нет линии в OSM-срезе или "
+                             "объект нарисован приблизительно)"})
+    res["result_digest"] = sha256_hex({k: v for k, v in res.items() if k != "result_digest"})
+    return res
+
+
+MAP_KEYS = {"graph_id", "graph_digest", "geometry", "geometry_precision"}
+
+
+def map_object_request(body):
+    """HTTP-вход: {graph_id, graph_digest, geometry, geometry_precision}. Граф — только из реестра."""
+    from .registry import _entry, load_graph_dict
+    if not isinstance(body, dict):
+        _bad("ожидается JSON-объект")
+    extra = sorted(set(body) - MAP_KEYS)
+    if extra:
+        _bad("неизвестные поля: " + ", ".join(extra[:10]), fields=extra[:10])
+    if not isinstance(body.get("graph_id"), str):
+        _bad("graph_id — строка", field="graph_id")
+    entry = _entry(body["graph_id"])
+    if body.get("graph_digest") != entry["digest"]:
+        raise ScenarioError("graph_digest_mismatch", "graph_digest не совпадает с текущей версией графа",
+                            {"expected": entry["digest"], "got": body.get("graph_digest")})
+    precision = body.get("geometry_precision")
+    if precision not in BUFFER_M:
+        _bad("geometry_precision — source | approximate | unknown", field="geometry_precision")
+    graph = {"id": entry["id"], "digest": entry["digest"]}
+    if entry["digest"] not in _GRIDS:
+        graph = load_graph_dict(entry["id"])
+    tags = osm_way_tags() if (entry.get("source") or {}).get("kind") == "overpass_snapshot" else {}
+    return propose_mapping(body.get("geometry"), precision, graph, tags)
