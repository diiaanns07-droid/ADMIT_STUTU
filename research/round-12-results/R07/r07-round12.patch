+++ b/tests/civic/R07/test_r07_schedule.py
@@ -0,0 +1,112 @@
+"""R07 round 12: schedule of two work variants (A/B) over all interval boundaries.
+
+* UI segmentation (scenarios.js scheduleSegments, run in Node) == engine segmentation (schedule.segments);
+* every segment equals a plain compare() at its start; totals equal timeline();
+* the phasing case is reproducible and keeps its documented numbers;
+* the unknown-access sensitivity is reported, never mixed into the main numbers.
+"""
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from engine.civic_scenarios import compare, timeline
+from engine.civic_scenarios.registry import load_graph
+from engine.civic_scenarios.schedule import schedule, segments
+
+ROOT = Path(__file__).resolve().parents[3]
+CASES = ROOT / "engine/civic_scenarios/cases"
+PHASING = json.loads((CASES / "astana-republic-sidewalk-phasing-v1.case.json").read_text("utf-8"))
+TINY = json.loads((CASES / "synthetic-tiny-v1.case.json").read_text("utf-8"))["payload"]
+
+TRICKY_PLANS = [
+    {"id": "A", "closures": [
+        {"edge_ids": ["x2", "x1"], "start_at": "2026-10-07T08:00:00+05:00", "end_at": "2026-10-07T18:00:00+05:00"},
+        {"edge_ids": ["x1"], "start_at": "2026-10-07T03:00:00Z", "end_at": "2026-10-08T00:00:00+05:00"},   # 08:00+05 == 03:00Z
+        {"edge_ids": [], "start_at": "2026-10-01T00:00:00+05:00", "end_at": "2026-10-30T00:00:00+05:00"}]},  # empty: ignored
+    {"id": "B", "closures": [
+        {"edge_ids": ["y"], "start_at": "2026-10-09T00:00:00+05:00", "end_at": "2026-10-10T00:00:00+05:00"}]},  # gap before
+]
+
+
+def js_segments(plans):
+    script = ("const s=require(process.argv[1]);process.stdout.write(JSON.stringify("
+              "globalThis.CivicScenarios.helpers.scheduleSegments(JSON.parse(process.argv[2]))))")
+    out = subprocess.run(["node", "-e", script, str(ROOT / "web/civic/scenarios/scenarios.js"), json.dumps(plans)],
+                         capture_output=True, text=True, check=True).stdout
+    return json.loads(out)
+
+
+def comparable(segs):
+    return [(s["start_at"], s["end_at"], s["active"], s["key"], s["none_active"]) for s in segs]
+
+
+@pytest.mark.skipif(not shutil.which("node"), reason="NOT_RUN: node недоступен")
+@pytest.mark.parametrize("plans", [TRICKY_PLANS, PHASING["payload"]["plans"], TINY["plans"]])
+def test_ui_and_engine_segment_the_same_way(plans):
+    assert comparable(js_segments(plans)) == comparable(segments(plans))
+
+
+def test_tricky_segmentation_semantics():
+    segs = segments(TRICKY_PLANS)
+    # same instant written with two offsets is one boundary; empty closure adds no boundary
+    assert [s["start_at"][:16] for s in segs] == ["2026-10-07T08:00", "2026-10-07T18:00", "2026-10-08T00:00", "2026-10-09T00:00"]
+    assert segs[0]["active"] == {"A": ["x1", "x2"], "B": []}
+    assert segs[1]["active"] == {"A": ["x1"], "B": []}
+    assert segs[2]["none_active"] is True                       # gap: nothing closed
+    assert segs[3]["active"] == {"A": [], "B": ["y"]}
+
+
+@pytest.fixture(scope="module")
+def phasing():
+    payload = PHASING["payload"]
+    graph = load_graph(payload["graph_id"])
+    return payload, graph, schedule(payload, graph)
+
+
+def test_each_segment_equals_plain_compare(phasing):
+    payload, graph, res = phasing
+    assert res["unique_states_computed"] == 3 and len(res["segments"]) == 3
+    for seg in res["segments"]:
+        direct = compare(dict(payload, analysis_at=seg["start_at"]), graph)
+        assert direct["result_digest"] == seg["result_digest"]
+        for p in direct["plans"]:
+            assert [r["length_m"] for r in p["routes"]] == [r["length_m"] for r in seg["plans"][p["id"]]["pairs"]]
+
+
+def test_totals_come_from_timeline(phasing):
+    payload, graph, res = phasing
+    tl = timeline(payload, graph, res["input"]["window_start"], res["input"]["window_end"])
+    assert res["totals"] == {p["id"]: p["totals"] for p in tl["plans"]}
+
+
+def test_phasing_case_documented_numbers(phasing):
+    payload, graph, res = phasing
+    assert PHASING["evidence_type"] == "hypothesis"
+    s0, s1, s2 = res["segments"]
+    assert [s["duration_h"] for s in res["segments"]] == [48.0, 24.0, 24.0]
+    assert len(s0["plans"]["A"]["active_closed_edge_ids"]) == 18 and len(s0["plans"]["B"]["active_closed_edge_ids"]) == 8
+    assert s0["plans"]["A"]["pairs"][0]["delta_m"] == 524.019          # city pair, full closure
+    assert s1["plans"]["B"]["pairs"][0]["delta_m"] == 200.956          # second phase
+    assert s2["plans"]["A"]["active_closed_edge_ids"] == []            # A already finished
+    assert res["totals"]["A"]["extra_length_m_h"] == 391387.896
+    assert res["totals"]["B"]["extra_length_m_h"] == 347081.616
+    assert all(r["status"] == "ok" for s in res["segments"] for p in s["plans"].values() for r in p["pairs"])
+    # reproducible
+    assert schedule(payload, graph)["result_digest"] == res["result_digest"]
+
+
+def test_unknown_access_sensitivity_is_separate(phasing):
+    payload, graph, res = phasing
+    row = res["segments"][0]["plans"]["A"]["pairs"][4]
+    assert row["delta_m"] == 641.161                                   # strict policy
+    assert row["if_unknown_access_allowed"]["delta_m"] == 0.0          # parallel path only via unknown edges
+    assert "sensitivity_note" in res
