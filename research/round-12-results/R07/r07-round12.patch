+"""R07 round 12: proposed mapping of a work object's geometry to graph edges.
+
+Synthetic street layout in metres around (71.40, 51.10):
+  main footway   y=0,   x=0..400 (4 edges of 100 m, connected)
+  far side       y=+25, x=0..400 (1 edge, NOT connected to the main footway)
+  crossing       x=200, y=-200..200 (2 edges, shares node with main footway)
+  bridge         x=300, y=-60..60 (OSM bridge=yes, layer=1; no shared node)
+"""
+import copy
+import json
+import math
+
+import pytest
+
+from engine.civic_scenarios import ScenarioError
+from engine.civic_scenarios.http import handle
+from engine.civic_scenarios.mapping import BUFFER_M, propose_mapping
+from engine.civic_scenarios.registry import manifest
+
+LON0, LAT0 = 71.40, 51.10
+KX, KY = 111320.0 * math.cos(math.radians(LAT0)), 110540.0
+
+
+def ll(x, y):
+    return [LON0 + x / KX, LAT0 + y / KY]
+
+
+def build():
+    nodes, edges = {}, []
+
+    def node(name, x, y):
+        nodes[name] = {"id": name, "lon": ll(x, y)[0], "lat": ll(x, y)[1]}
+        return name
+
+    def edge(eid, a, b, access="allowed", way=None, name=""):
+        pa, pb = nodes[a], nodes[b]
+        L = math.hypot((pb["lon"] - pa["lon"]) * KX, (pb["lat"] - pa["lat"]) * KY)
+        edges.append({"id": eid, "from": a, "to": b, "length_m": round(L, 3), "access": access, "oneway": False,
+                      "geometry": [[pa["lon"], pa["lat"]], [pb["lon"], pb["lat"]]], "name": name,
+                      "osm_way_id": way})
+    for i in range(5):
+        node(f"m{i}", i * 100, 0)
+    for i in range(4):
+        edge(f"main-{i}", f"m{i}", f"m{i + 1}", way=1, name="Тротуар")
+    node("f0", 0, 25), node("f1", 400, 25)
+    edge("far", "f0", "f1", way=2, name="Тротуар напротив")
+    node("c0", 200, -200), node("c1", 200, 200)
+    edge("cross-s", "c0", "m2", access="unknown", way=3, name="Поперечная")
+    edge("cross-n", "m2", "c1", access="unknown", way=3, name="Поперечная")
+    node("b0", 300, -60), node("b1", 300, 60)
+    edge("bridge", "b0", "b1", way=4, name="Мост")
+    return {"id": "test-mapping", "digest": "test-mapping-digest", "nodes": list(nodes.values()), "edges": edges}
+
+
+GRAPH = build()
+TAGS = {1: {"highway": "footway"}, 2: {"highway": "footway"}, 3: {"highway": "residential"},
+        4: {"highway": "footway", "bridge": "yes", "layer": "1"}}
+
+
+def line(*pts):
+    return {"type": "LineString", "coordinates": [ll(x, y) for x, y in pts]}
+
+
+def ids(rows):
+    return sorted(r["edge_id"] for r in rows)
+
+
+def test_line_along_footway_proposes_it_not_the_crossing_street():
+    r = propose_mapping(line((0, 2), (400, 2)), "source", GRAPH, TAGS)
+    assert r["status"] == "proposed" and r["requires_confirmation"] is True
+    assert ids(r["proposed"]) == ["main-0", "main-1", "main-2", "main-3"]
+    assert "cross-n" not in ids(r["proposed"] + r["partial"]) and "far" not in ids(r["proposed"])
+    assert r["object_covered_share"] == 1.0 and r["unmatched_object_parts"] == []
+    assert "plans" not in r and "closures" not in json.dumps(r)        # never a ready-made closure
+
+
+def test_bridge_over_the_line_is_flagged_not_silently_proposed():
+    r = propose_mapping(line((0, 2), (400, 2)), "source", GRAPH, TAGS)
+    assert "bridge" not in ids(r["proposed"])          # only ~24 m of a 120 m bridge is near the line
+    r = propose_mapping(line((300, -60), (300, 60)), "source", GRAPH, TAGS)
+    assert ids(r["proposed"]) == ["bridge"]
+    assert any(w["code"] == "bridge_or_tunnel_proposed" for w in r["warnings"])
+
+
+def test_approximate_geometry_also_catches_far_side_and_warns_about_groups():
+    r = propose_mapping(line((0, 2), (400, 2)), "approximate", GRAPH, TAGS)
+    assert {"far", "main-0"} <= set(ids(r["proposed"]))
+    assert any(w["code"] == "disconnected_groups" for w in r["warnings"])
+    assert r["by_osm_way"][0]["osm_way_id"] == 1                 # closest line listed first
+    assert r["rule"]["buffer_m"] == BUFFER_M["approximate"]
+
+
+def test_unmatched_part_of_object_is_reported():
+    r = propose_mapping(line((0, 0), (550, 0)), "source", GRAPH, TAGS)
+    assert r["object_length_m"] == pytest.approx(550, abs=1)
+    (part,) = r["unmatched_object_parts"]
+    assert part["length_m"] == pytest.approx(150 - BUFFER_M["source"], abs=STEP_TOL)
+    assert any(w["code"] == "unmatched_object_parts" for w in r["warnings"])
+
+
+STEP_TOL = 6
+
+
+def test_point_never_proposes_edges():
+    r = propose_mapping({"type": "Point", "coordinates": ll(150, 3)}, "approximate", GRAPH, TAGS)
+    assert r["status"] == "point_needs_manual_selection" and r["proposed"] == []
+    assert r["partial"][0]["edge_id"] == "main-1"
+
+
+def test_polygon_inside_proposed_edge_partially_inside_is_partial():
+    ring = [ll(50, -10), ll(250, -10), ll(250, 10), ll(50, 10), ll(50, -10)]
+    r = propose_mapping({"type": "Polygon", "coordinates": [ring]}, "source", GRAPH, TAGS)
+    assert ids(r["proposed"]) == ["main-1"]
+    assert {"main-0", "main-2"} <= set(ids(r["partial"]))
+
+
+def test_no_geometry_and_invalid_geometry():
+    empty = propose_mapping(None, "unknown", GRAPH, TAGS)
+    assert empty["status"] == "no_geometry" and len(empty["result_digest"]) == 64
+    for bad in ({"type": "Point", "coordinates": [500, 0]}, {"type": "Circle", "coordinates": [0, 0]},
+                {"type": "LineString", "coordinates": [ll(0, 0)]}, {"type": "Point", "coordinates": [float("nan"), 0]},
+                {"type": "LineString", "coordinates": [ll(0, 0), ll(1, 1)], "url": "http://x"}):
+        with pytest.raises(ScenarioError):
+            propose_mapping(bad, "source", GRAPH, TAGS)
+    with pytest.raises(ScenarioError) as e:
+        propose_mapping(line(*[(i, 0) for i in range(2001)]), "source", GRAPH, TAGS)
+    assert e.value.code == "too_large"
+
+
+def test_unknown_precision_warns_and_result_is_deterministic():
+    r1 = propose_mapping(line((0, 2), (400, 2)), "garbage", GRAPH, TAGS)
+    assert r1["rule"]["precision"] == "unknown" and any(w["code"] == "precision_unknown" for w in r1["warnings"])
+    assert propose_mapping(line((0, 2), (400, 2)), "garbage", copy.deepcopy(GRAPH), TAGS)["result_digest"] == r1["result_digest"]
+
+
+def test_http_map_object_contract():
+    tiny = next(g for g in manifest()["graphs"] if g["id"] == "synthetic-tiny-v1")
+    api = "/api/civic/v1/scenarios/map-object"
+    body = {"graph_id": tiny["id"], "graph_digest": tiny["digest"], "geometry": None, "geometry_precision": "unknown"}
+    r = handle("POST", api, body=body)
+    assert r["status"] == 200 and r["body"]["data"]["status"] == "no_geometry"
+    for patch, status, code in (({"graph_digest": "0" * 64}, 409, "graph_digest_mismatch"),
+                                ({"graph_id": "/etc/passwd"}, 404, "unknown_graph"),
+                                ({"file": "x"}, 422, "invalid_payload"),
+                                ({"geometry_precision": "exact"}, 422, "invalid_payload")):
+        r = handle("POST", api, body=dict(body, **patch))
+        assert r["status"] == status and r["body"]["error"]["code"] == code, patch
+    assert handle("GET", api)["status"] == 405
-- 
